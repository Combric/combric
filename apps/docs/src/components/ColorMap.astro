---
import Color from "colorjs.io";
import {
  primitiveCssVariableNames,
  primitiveTokens,
  semanticCssVariableNames,
  semanticTokenReferences,
  semanticTokens,
} from "@combric/tokens";
import { tailwindThemeMappings } from "../../../../scripts/lib/tailwind-theme-mappings.mjs";

const primitiveColors = Object.entries(primitiveTokens).filter(([name]) => name.startsWith("color."));
const semanticColors = Object.entries(semanticTokens).filter(([name]) => name.startsWith("color."));
const tailwindBySemantic = new Map(tailwindThemeMappings.map(([tailwind, semantic]) => [semantic, tailwind]));

function derived(value: string) {
  const color = new Color(value);
  const rgb = color.to("srgb");
  const oklch = color.to("oklch");
  const channels = rgb.coords.map((channel) => Math.round((channel ?? 0) * 255));
  const alpha = Number(color.alpha.toFixed(3));
  const lightness = oklch.coords[0] ?? 0;
  const chroma = oklch.coords[1] ?? 0;
  const hueCoordinate = oklch.coords[2];
  const hue = hueCoordinate !== null && Number.isFinite(hueCoordinate) ? `${hueCoordinate.toFixed(2)}` : "none";
  return {
    rgb: `rgb(${channels.join(" ")}${alpha < 1 ? ` / ${alpha}` : ""})`,
    oklch: `oklch(${(lightness * 100).toFixed(2)}% ${chroma.toFixed(4)} ${hue}${alpha < 1 ? ` / ${alpha}` : ""})`,
  };
}
---

<h2>Primitive palette</h2>
<p>Primitive tokens own raw reusable values. RGB and OKLCH are derived for documentation display and do not replace the canonical string.</p>
<div class="combric-docs-token-table-wrap" tabindex="0" role="region" aria-label="Primitive color token table"><table class="combric-docs-token-table"><thead><tr><th>Swatch</th><th>Primitive</th><th>Canonical</th><th>CSS variable</th><th>Derived RGB</th><th>Derived OKLCH</th></tr></thead><tbody>
{primitiveColors.map(([name, value]) => { const conversion = derived(value); return <tr><td><span class="combric-docs-swatch" style={`background:${value}`} aria-hidden="true"></span></td><td><code>{name}</code></td><td><code>{value}</code></td><td><code>{primitiveCssVariableNames[name as keyof typeof primitiveCssVariableNames]}</code></td><td><code>{conversion.rgb}</code></td><td><code>{conversion.oklch}</code></td></tr>; })}
</tbody></table></div>

<h2>Semantic roles</h2>
<p>Semantic tokens are purpose-driven references, not duplicated colors.</p>
<div class="combric-docs-token-table-wrap" tabindex="0" role="region" aria-label="Semantic color token table"><table class="combric-docs-token-table"><thead><tr><th>Role</th><th>Primitive reference</th><th>Resolved</th><th>CSS variable</th><th>Tailwind theme mapping</th></tr></thead><tbody>
{semanticColors.map(([name, value]) => <tr><td><code>{name}</code></td><td><code>{semanticTokenReferences[name as keyof typeof semanticTokenReferences]}</code></td><td><span class="combric-docs-swatch" style={`background:${value}`} aria-hidden="true"></span> <code>{value}</code></td><td><code>{semanticCssVariableNames[name as keyof typeof semanticCssVariableNames]}</code></td><td>{tailwindBySemantic.has(name) ? <code>{tailwindBySemantic.get(name)}</code> : "Not mapped"}</td></tr>)}
</tbody></table></div>

<h2>Verified state colors</h2>
<ul>
  <li><code>color.accent.hover</code> — primary accent hover.</li>
  <li><code>color.focus</code> — focus-visible outlines and focus-within treatment.</li>
  <li><code>color.invalid</code> — invalid controls and the current error Alert border.</li>
</ul>
<p>Combric currently has no success, warning, info, generic danger, or disabled color token. Disabled components use opacity. Active Tabs reuse the accent role.</p>

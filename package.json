{
  "name": "combric",
  "version": "0.0.0",
  "private": true,
  "description": "Performance-first UI framework for modern web applications",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm clean && tsc -b tsconfig.build.json --force --pretty false && node scripts/generate-token-css.mjs && node scripts/build-layout-css.mjs && node scripts/build-react-css.mjs && node scripts/generate-tailwind-css.mjs",
    "clean": "node scripts/clean.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "pnpm build && pnpm test:built",
    "test:built": "node --test",
    "test:tailwind:built": "node --test test/tailwind-adapter.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "docs:build": "pnpm --filter @combric/docs build",
    "docs:check": "pnpm --filter @combric/docs check",
    "docs:test": "pnpm --filter @combric/docs test:e2e",
    "docs:validate": "node scripts/validate-docs.mjs",
    "test:consumer:packed": "node scripts/validate-packed-consumer.mjs",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build && pnpm test:built && pnpm validate:packages:built && pnpm validate:package-packs:built",
    "validate:package-packs:built": "node scripts/validate-package-packs.mjs",
    "validate:packages": "pnpm build && pnpm validate:packages:built",
    "validate:packages:built": "node scripts/validate-packages.mjs"
  },
  "devDependencies": {
    "@combric/layout": "workspace:*",
    "@combric/react": "workspace:*",
    "@combric/tailwind": "workspace:*",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@eslint/js": "10.0.1",
    "@tailwindcss/cli": "4.3.3",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "jsdom": "30.1.0",
    "prettier": "3.9.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "tailwindcss": "4.3.3",
    "typescript-eslint": "8.70.0"
  }
}

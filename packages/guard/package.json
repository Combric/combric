{
  "name": "@combric/guard",
  "version": "1.1.1",
  "description": "Read-only consumer-side integration checks for Combric",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "combric-guard": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@combric/tokens": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "24.13.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Combric/combric.git",
    "directory": "packages/guard"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
